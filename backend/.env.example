# Copy this file to .env and fill in your own values.
PORT=5000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lightning_mcqueen
DB_USER=postgres
DB_PASSWORD=your_password_here

# Address of the React frontend (for CORS)
CLIENT_URL=http://localhost:5173

# Secret key needed to view saved enquiries at GET /api/enquiries
ADMIN_KEY=change_this_to_a_long_random_string